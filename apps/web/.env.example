# SCOUT web (Next.js on Vercel). Copy to .env.local and fill in. Never commit real values.
# Server-only: none of these may be exposed via NEXT_PUBLIC_*.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (look up current model names and free-tier limits in Google's docs) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Optional: tailoring model (defaults to GEMINI_MODEL)
GEMINI_TAILOR_MODEL=
LLM_DAILY_SOFT_CAP_SCORE=
LLM_DAILY_SOFT_CAP_EMBED=
LLM_DAILY_SOFT_CAP_TAILOR=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Auth (one shared password, two profiles) ---
# `pnpm -C apps/web hash-password` / `gen-secret` print these. In THIS file every `$` in the hash must be written as `\$`
# (Next expands `$VAR` in .env files). On Vercel paste the raw hash.
APP_PASSWORD_HASH=
SESSION_SECRET=

# --- GitHub (Scan now -> workflow_dispatch) ---
GITHUB_TOKEN=
GITHUB_REPO=

# --- App ---
APP_URL=http://localhost:3000
TZ=Asia/Kolkata

# Optional: only for `pnpm -C apps/web db:types` (personal access token, NOT the service role key)
SUPABASE_ACCESS_TOKEN=
