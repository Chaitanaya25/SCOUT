# SCOUT web (Next.js on Vercel). Copy to .env.local and fill in. Never commit real values.
# Server-only: none of these may be exposed via NEXT_PUBLIC_*.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (look up current model names and free-tier limits in Google's docs) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=
LLM_DAILY_SOFT_CAP_SCORE=
LLM_DAILY_SOFT_CAP_EMBED=
LLM_DAILY_SOFT_CAP_TAILOR=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Auth (one shared password, two profiles) ---
APP_PASSWORD_HASH=
SESSION_SECRET=

# --- GitHub (Scan now -> workflow_dispatch) ---
GITHUB_TOKEN=
GITHUB_REPO=

# --- App ---
APP_URL=http://localhost:3000
TZ=Asia/Kolkata
