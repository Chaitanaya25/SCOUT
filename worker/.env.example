# SCOUT worker (Python, GitHub Actions). Copy to .env and fill in. Never commit real values.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase pooler (Supavisor) connection string, used by psycopg; GitHub runners are IPv4-only, so use the pooler, not the direct host
DATABASE_URL=

# --- Gemini (look up current model names and free-tier limits in Google's docs) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Optional: tailoring model (defaults to GEMINI_MODEL)
GEMINI_TAILOR_MODEL=
# Daily soft caps, kept well below the free-tier limits shown in AI Studio (empty = built-in default)
LLM_DAILY_SOFT_CAP_SCORE=
LLM_DAILY_SOFT_CAP_EMBED=
LLM_DAILY_SOFT_CAP_TAILOR=
LLM_DAILY_SOFT_CAP_PARSE=
LLM_DAILY_SOFT_CAP_EXTRACT=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- App (links in Telegram messages) ---
APP_URL=http://localhost:3000

# --- Adzuna ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Source flags (true/false) ---
# jobspy sites (public listings only): comma-separated subset of linkedin,indeed,google,naukri,glassdoor
JOBSPY_SITES=linkedin,indeed,google,naukri,glassdoor
ENABLE_JOBSPY=true
ENABLE_ADZUNA=true
ENABLE_INTERNSHALA=true
ENABLE_REMOTEOK=true
ENABLE_REMOTIVE=true
ENABLE_HIMALAYAS=true
ENABLE_ARBEITNOW=true
ENABLE_WEWORKREMOTELY=true
ENABLE_GREENHOUSE=true
ENABLE_LEVER=true
ENABLE_ASHBY=true
ENABLE_WORKDAY=true
ENABLE_SMARTRECRUITERS=true
ENABLE_GENERIC_CAREERS=true

# --- Pipeline tuning (defaults per PRD/ARCHITECTURE; adjust later) ---
SCORE_TOP_K=
SCORE_BATCH_SIZE=
MAX_INDIVIDUAL_ALERTS=8

TZ=Asia/Kolkata
