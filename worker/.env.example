# SCOUT worker (Python, GitHub Actions). Copy to .env and fill in. Never commit real values.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Pooler connection string, used by psycopg
DATABASE_URL=

# --- Gemini (look up current model names and free-tier limits in Google's docs) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=
LLM_DAILY_SOFT_CAP_SCORE=
LLM_DAILY_SOFT_CAP_EMBED=
LLM_DAILY_SOFT_CAP_TAILOR=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- App (links in Telegram messages) ---
APP_URL=http://localhost:3000

# --- Adzuna ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Source flags (true/false) ---
ENABLE_JOBSPY=true
ENABLE_ADZUNA=true
ENABLE_INTERNSHALA=true
ENABLE_REMOTEOK=true
ENABLE_REMOTIVE=true
ENABLE_HIMALAYAS=true
ENABLE_ARBEITNOW=true
ENABLE_WEWORKREMOTELY=true
ENABLE_GREENHOUSE=true
ENABLE_LEVER=true
ENABLE_ASHBY=true
ENABLE_WORKDAY=true
ENABLE_SMARTRECRUITERS=true
ENABLE_GENERIC_CAREERS=true

# --- Pipeline tuning (defaults per PRD/ARCHITECTURE; adjust later) ---
SCORE_TOP_K=
SCORE_BATCH_SIZE=
MAX_INDIVIDUAL_ALERTS=8

TZ=Asia/Kolkata
